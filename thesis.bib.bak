File outline
 

@article{ciocarlie_velo_2014,
	title = {The {Velo} gripper: {A} versatile single-actuator design for enveloping, parallel and fingertip grasps},
	volume = {33},
	issn = {0278-3649, 1741-3176},
	shorttitle = {The {Velo} gripper},
	url = {http://journals.sagepub.com/doi/10.1177/0278364913519148},
	doi = {10.1177/0278364913519148},
	abstract = {We design, optimize and demonstrate the behavior of a tendon-driven robotic gripper performing parallel, enveloping and ﬁngertip grasps. The gripper consists of two ﬁngers, each with two links, and is actuated using a single active tendon. During unobstructed closing, the distal links remain parallel, for parallel grasps. If the proximal links are stopped by contact with an object, the distal links start ﬂexing, creating a stable enveloping grasp. We optimize the route of the active ﬂexor tendon and the route and stiffness of a passive extensor tendon in order to achieve this behavior. We show how the resulting gripper can also execute ﬁngertip grasps for picking up small objects off a ﬂat surface, using contact with the surface to its advantage through passive adaptation. Finally, we introduce a method for optimizing the dimensions of the links in order to achieve enveloping grasps of a large range of objects, and apply it to a set of common household objects.},
	language = {en},
	number = {5},
	urldate = {2024-08-28},
	journal = {The International Journal of Robotics Research},
	author = {Ciocarlie, Matei and Hicks, Fernando Mier and Holmberg, Robert and Hawke, Jeffrey and Schlicht, Michael and Gee, Jeff and Stanford, Scott and Bahadur, Ryan},
	month = apr,
	year = {2014},
	pages = {753--767},
	file = {Ciocarlie 等 - 2014 - The Velo gripper A versatile single-actuator desi.pdf:C\:\\Users\\83730\\Zotero\\storage\\TMN5PPI2\\Ciocarlie 等 - 2014 - The Velo gripper A versatile single-actuator desi.pdf:application/pdf},
}

